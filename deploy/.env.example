# Host deployment user. Run `id -u` and `id -g`, then put those values here.
# The container runs as this UID/GID so it can write ./data and ./backups.
# Required: do not leave these blank.
PUID=
PGID=

# Public URL used by QR codes and share links. Must match the browser URL.
PUBLIC_URL=https://monopay.example.com

# Bind address for the app port.
# Use 127.0.0.1 when a reverse proxy is on the same host.
# Use 0.0.0.0 only for direct IP/LAN access.
BIND_ADDR=127.0.0.1
APP_PORT=3000
TRUST_PROXY=true

MONOPAY_IMAGE=ghcr.io/shanggui/monopay
MONOPAY_TAG=v0.1.1
LOG_LEVEL=info
