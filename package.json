{
  "name": "monopay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @monopay/web --filter @monopay/server dev",
    "build": "pnpm --filter @monopay/web build && pnpm --filter @monopay/server build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @monopay/web typecheck && pnpm --filter @monopay/server typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshot": "node scripts/screenshot.mjs",
    "flow:m1": "node scripts/m1-flow.mjs",
    "flow:m2": "node scripts/m2-flow.mjs",
    "flow:m3": "node scripts/m3-flow.mjs",
    "flow:m4": "node scripts/m4-flow.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^10.0.0"
  }
}
