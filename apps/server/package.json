{
  "name": "@monopay/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.0.0",
    "@monopay/ledger-core": "workspace:*",
    "@monopay/shared": "workspace:*",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.0",
    "tsup": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
